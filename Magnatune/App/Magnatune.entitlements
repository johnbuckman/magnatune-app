<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- A sandboxed app's keychain items are scoped by its keychain access group, which
	     defaults to the application-identifier entitlement. Without this the membership
	     password could not be stored or read (SecItemAdd/SecItemCopyMatching fail with
	     errSecMissingEntitlement), so basicAuthHeader() was always nil — harmless while
	     he3 served member audio unauthenticated, fatal once /music required HTTP Basic. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.magnatune.player</string>
	</array>
</dict>
</plist>
